#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define GHK LG(LA(LCTRL))

/ {
	behaviors {
		mth: mod_tap_homerow {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			//require-prior-idle-ms = <100>
			bindings = <&kp>, <&kp>;
			display-name = "Mod-Tap";
		};

		mtp: mod_tap_pinky {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			//require-prior-idle-ms = <100>
			bindings = <&kp>, <&kp>;
			display-name = "Mod-Tap";
		};
	};

	macros {
		s_ins: shift_insert {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings
			= <&macro_press &kp LSHFT>
			, <&macro_tap &kp INS>
			, <&macro_release &kp LSHFT>
			;
		};
	};

	// TODO: BT
	// TODO: oneshot GHK, lock
	// TODO: layer oneshot / lock
	// TODO: oneshot shift, lock

        keymap {
                compatible = "zmk,keymap";

                default_layer { // 0
                        display-name = "Default Layer";
// -----------------------------------------------------------------------------------------
// | GHK  |  Q  |  W  |  E  |  R  |  T  |      |  Y  |  U   |  I  |  O  |  P    | PRINT |
// | TAB  |  A  |  S  |  D  |  F  |  G  |      |  H  |  J   |  K  |  L  |  RALT |       |
// |      |  Z  |  X  |  C  |  V  |  B  |      |  N  |  M   |  ,  |  .  |  RET  |       |
//                       | GUI | LWR | SPC | | ENT | RSE  | ALT |
                        bindings = <
   &sk GHK  &kp Q        &kp W        &kp E       &kp R        &kp T      &kp Y    &kp U       &kp I        &kp O       &kp P          &kp PSCRN
   &kp TAB  &mtp LGUI A  &mth LCTRL S &mth LALT D &mth LSHFT F &kp G      &kp H    &mth RSFT J &mth LALT K  &mth RCTL L &mth LGUI RALT &none
   &mo 4    &kp Z        &kp X        &kp C       &kp V        &kp B      &kp N    &kp M       &kp COMMA    &kp DOT     &kp RET        &none
                                        &mo 3       &kp LSHFT    &mo 2  &kp BSPC &kp SPACE   &mo 1
                        >;
                };

                symbol_layer { // 1
                        display-name = "Symbol Layer";
// -----------------------------------------------------------------------------------------
// |      |  @  |  _  |  [  |  ]  |  ^  |       |  !  |  <  |  >  |  =  |  &  |      |
// |      |  \  |  /  |  {  |  }  |  *  |       |  ?  |  (  |  )  |  -  |  :  |      |
// |      |  #  |  $  |  |  |  ~  |  `  |       |  +  |  %  |  "  |  '  |  ;  |      |
//                      |     |     |     |   |     |     |     |
                        bindings = <
   &trans &kp AT   &kp UNDER &kp LBKT &kp RBKT  &kp CARET    &kp EXCL  &kp LT    &kp GT    &kp EQUAL &kp AMPS &trans
   &trans &kp BSLH &kp FSLH  &kp LBRC &kp RBRC  &kp ASTRK    &kp QMARK &kp LPAR  &kp RPAR  &kp MINUS &kp COLON&trans
   &trans &kp HASH &kp DLLR  &kp PIPE &kp TILDE &kp GRAVE    &kp PLUS  &kp PRCNT &kp DQT   &kp SQT   &kp SEMI &trans
                               &trans   &trans    &trans   &trans    &trans    &trans
                        >;
                };

                nav_layer { // 2
                        display-name = "Navigation Layer";
// -----------------------------------------------------------------------------------------
// |      | PgUp| Bspc| up  | del  | PgDn|       |  -  |  7  |  8  |  9  |  +  |      |
// |      | Home| left| down| right| end |       |  .  |  4  |  5  |  6  |  ,  |      |
// |      | Esc | sIns| ins | ENT  | spac|       |  :  |  1  |  2  |  3  | ENT |      |
//                      |     |     |     |   |     |     |  0  |
                        bindings = <
   &trans &kp PG_UP &kp BSPC &kp UP   &kp DEL   &kp PG_DN   &kp MINUS &kp N7   &kp N8   &kp N9   &kp PLUS  &trans
   &trans &kp HOME  &kp LEFT &kp DOWN &kp RIGHT &kp END     &kp DOT   &kp N4   &kp N5   &kp N6   &kp COMMA &trans
   &trans &kp ESC   &s_ins   &kp INS  &kp RET   &kp SPACE   &kp COLON &kp N1   &kp N2   &kp N3   &kp RET   &trans
                               &trans   &trans    &trans  &trans    &trans   &kp N0
                        >;
                };

		fn_layer { // 3
                        display-name = "function Layer";
// -----------------------------------------------------------------------------------------
// | RESET| F1  | F2  | F3  | F4   | F5  |       | num | VOLD| VOLU| MUTE|     | RESET|
// |      | F6  | F7  | F8  | F9   | F10 |       |     |     |     |     |     |      |
// |      | F11 | F11 | MENU| print| caps|       |mprev|mstop|mplay|mnext|     |      |
//                      |     |     |     |   |     |     |     |
                        bindings = <
   &sys_reset  &kp F1       &kp F2        &kp F3       &kp F4         &kp F5         &kp KP_NUM &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans   &sys_reset
   &bootloader &kp F6       &kp F7        &kp F8       &kp F9         &kp F10        &trans     &trans       &trans       &trans     &trans   &bootloader
   &trans      &kp F11      &kp F12       &kp K_APP    &kp PSCRN      &kp CAPS       &kp C_PREV &kp C_STOP   &kp C_PAUSE  &kp C_NEXT &trans   &trans
                                            &trans       &trans         &trans   &trans       &trans       &trans
                        >;
                };

		bt_layer { // 4
                        display-name = "bluetooth Layer";
// -----------------------------------------------------------------------------------------
// |      |     |     |    |    |     |       |     |     |     |     |     |      |
// |      |     |     |    |    |     |       |     |     |     |     |     |      |
// |      |     |     |    |    |     |       |     |     |     |     |     |      |
//                      |    |    |     |   |     |     |     |
                        bindings = <
   &out OUT_BLE &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5   &trans &trans &trans &trans &trans &trans
   &out OUT_USB &trans       &trans       &trans       &trans       &trans         &trans &trans &trans &trans &trans &trans
   &trans       &trans       &trans       &trans       &trans       &bt BT_CLR     &trans &trans &trans &trans &trans &trans
                                           &trans       &trans       &trans       &trans &trans &trans
                        >;
                };

        };
};
